:: F8 {"position":"775,150","size":"100,100"}
<<set _corr to ['B']>>
<<set _correctCount=0>><<set _missed=0>><<set _wrong=0>>
<<for _a range _corr>><<if $q8sel.includes(_a)>><<set _correctCount +=1>><<else>><<set _missed +=1>><</if>><</for>>
